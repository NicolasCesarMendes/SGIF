@model ManutencaoViewModel
@{
    ViewData["Title"] = "Manutenção";

    string NomeClassificacao(string c) => c switch { "Critico" => "Crítico", "Medio" => "Médio", _ => c };
    string ClasseBorda(string c) => c switch { "Critico" => "border-error", "Alto" => "border-warning", "Medio" => "border-info", _ => "border-success" };
    string ClasseRisco(string c) => c switch { "Critico" => "badge-error", "Alto" => "badge-warning", "Medio" => "badge-info", _ => "badge-success" };
    string ClasseProgresso(string c) => c switch { "Critico" => "progress-error", "Alto" => "progress-warning", "Medio" => "progress-info", _ => "progress-success" };
    int Contar(string c) => Model.Itens.Count(i => i.Classificacao == c);

    int posicao = 0;
}

<div class="flex flex-wrap justify-between items-center gap-2 mb-1">
    <h1 class="text-2xl m-0">Manutenção</h1>
    <a class="btn btn-outline btn-sm" asp-action="ManutencaoExibir">Atualizar</a>
</div>

<p class="text-muted mb-3">
    Plano de intervenções ordenado pelo risco de falha. Atualiza sozinho a cada @Model.SegundosParaAtualizar segundos.
    <span class="text-muted text-sm" data-vue="atualizacao" data-regiao="regiao-manutencao" data-segundos="@Model.SegundosParaAtualizar">
        <span v-text="status"></span>
        <button type="button" class="btn btn-ghost btn-sm" v-on:click="alternar" v-text="pausado ? 'Retomar' : 'Pausar'">Pausar</button>
    </span>
</p>

<!-- Esta região é atualizada pelo componente Vue de atualização automática. -->
<div id="regiao-manutencao">

<p class="text-muted text-sm mb-3">
    Gerado em @Model.GeradoEm.ToString("dd/MM/yyyy HH:mm:ss"), com os dados das últimas @Model.HorasDaAnalise h.
</p>

<!-- Quantidade de ativos por classificação de risco -->
<div class="grid grid-cols-12 gap-2 mb-3">
    @foreach (string c in new[] { "Critico", "Alto", "Medio", "Baixo" })
    {
        <div class="col-span-6 md:col-span-3">
            <div class="card card-border bg-base-100 text-center @ClasseBorda(c)">
                <div class="card-body py-2">
                    <div class="text-3xl font-semibold">@Contar(c)</div>
                    <div class="text-sm text-muted">@NomeClassificacao(c)</div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Itens.Count == 0)
{
    <div class="alert bg-base-100 border">
        Nenhum ativo para avaliar. Cadastre ativos e sensores na Frota para o plano aparecer aqui.
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ativo</th>
                    <th>Estado</th>
                    <th style="min-width: 150px;">Risco</th>
                    <th>Motivos</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RiscoAtivo item in Model.Itens)
                {
                    posicao++;
                    
                    string nomeTipo = item.TipoAtivo == "Vagao" ? "Vagão" : "Locomotiva";

                    <tr>
                        <td>@posicao</td>
                        <td>
                            <a asp-controller="Ficha" asp-action="FichaExibir" asp-route-tipo="@item.TipoAtivo" asp-route-id="@item.IdAtivo"
                               class="font-semibold no-underline">@nomeTipo @item.Numero</a>
                            <div class="text-muted text-sm">@item.Descricao</div>
                        </td>
                        <td>
                            @if (item.Estado == "Em manutencao")
                            {
                                <span class="badge badge-warning">@FrotaViewModel.NomeEstado(item.Estado)</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@FrotaViewModel.NomeEstado(item.Estado)</span>
                            }
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold">@item.Pontuacao</span>
                                <span class="badge @ClasseRisco(item.Classificacao)">@NomeClassificacao(item.Classificacao)</span>
                            </div>
                            <progress class="progress mt-1 @ClasseProgresso(item.Classificacao)" value="@item.Pontuacao" max="100" aria-label="Risco @item.Pontuacao por cento"></progress>
                        </td>
                        <td>
                            @if (item.Motivos.Count == 0)
                            {
                                <span class="text-muted text-sm">Nenhum ponto de atenção.</span>
                            }
                            else
                            {
                                <ul class="mb-0 ps-3 text-sm">
                                    @foreach (string motivo in item.Motivos)
                                    {
                                        <li>@motivo</li>
                                    }
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>

<details class="mt-3">
    <summary class="font-semibold">Como a pontuação é calculada</summary>
    <div class="text-sm text-muted mt-2">
        <p class="mb-1">A pontuação vai de 0 a 100 e soma quatro partes:</p>
        <ul class="mb-2">
            <li>Alertas ainda não resolvidos do ativo (até 50 pontos).</li>
            <li>Nível da leitura mais recente dos sensores (até 20 pontos).</li>
            <li>Tendência de alta nas últimas @Model.HorasDaAnalise h e o tempo estimado para atingir os limites (até 20 pontos).</li>
            <li>Leituras fora do padrão de cada sensor, além do esperado por acaso (até 10 pontos).</li>
        </ul>
        <p class="mb-0">
            Classificação: Crítico a partir de 70, Alto a partir de 40, Médio a partir de 15 e Baixo abaixo disso.
            Ativos inativos não entram. Os pesos são critérios iniciais da equipe, a serem calibrados com dados reais.
        </p>
    </div>
</details>
