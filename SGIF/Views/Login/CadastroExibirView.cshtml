@model SGIF.Models.CadastroViewModel
@{
    ViewData["Title"] = "Criar conta";
    ViewData["Publica"] = true;
    ViewData["SemCabecalho"] = true;
}

<section class="mx-auto flex w-full max-w-lg flex-1 items-center px-5 py-12">
    <div class="card card-border w-full bg-base-100 shadow-sm">
        <div class="card-body gap-5 p-7 sm:p-9">
            <div class="text-center">
                <span class="mx-auto mb-3 inline-flex size-12 items-center justify-center rounded-box bg-primary text-primary-content"><partial name="_Icone" model='"train"' /></span>
                <h1 class="font-serif text-3xl">Criar conta</h1>
                <p class="mt-2 text-muted">SGIF - Sistema de Gestão Industrial Ferroviário</p>
            </div>

            @if (ViewBag.Erro != null) { <div class="alert alert-error" role="alert">@ViewBag.Erro</div> }

            <form asp-controller="Login" asp-action="CadastrarProcessar" method="post" class="space-y-4">
                <label class="campo">
                    <span class="rotulo">Nome</span>
                    <input asp-for="Nome" autocomplete="name" maxlength="200" placeholder="Digite o seu nome" class="input w-full" />
                    <span asp-validation-for="Nome" class="erro"></span>
                </label>
                <label class="campo">
                    <span class="rotulo">E-mail</span>
                    <input asp-for="Email" type="email" autocomplete="username" maxlength="150" placeholder="Digite o seu e-mail" class="input w-full" />
                    <span asp-validation-for="Email" class="erro"></span>
                </label>
                <label class="campo">
                    <span class="rotulo">Senha</span>
                    <input asp-for="Senha" type="password" autocomplete="new-password" placeholder="Mínimo de 6 caracteres" class="input w-full" />
                    <span asp-validation-for="Senha" class="erro"></span>
                </label>
                <label class="campo">
                    <span class="rotulo">Confirmar senha</span>
                    <input asp-for="ConfirmarSenha" type="password" autocomplete="new-password" placeholder="Repita a senha" class="input w-full" />
                    <span asp-validation-for="ConfirmarSenha" class="erro"></span>
                </label>
                <button type="submit" class="btn btn-primary w-full">Cadastrar</button>
            </form>
            <p class="text-center text-sm text-muted">Já tem conta? <a asp-controller="Login" asp-action="LoginExibir" class="link link-primary">Entrar</a></p>
        </div>
    </div>
</section>
