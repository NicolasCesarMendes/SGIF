@model SGIF.Models.CadastroViewModel
@{
    ViewData["Title"] = "Criar conta";
    ViewData["Publica"] = true;
    ViewData["SemCabecalho"] = true;
}

<div class="acesso">
    <partial name="_Lateral" />

    <section class="acesso-area">
        <div class="acesso-form">
            <h1 class="acesso-h1">Criar conta <span class="destaque"><span>no SGIF</span></span></h1>
            <p class="acesso-sub">Novas contas começam como Funcionário (somente consulta).</p>

            @if (ViewBag.Erro != null) { <div class="alert alert-error mt-4" role="alert">@ViewBag.Erro</div> }

            <form asp-controller="Login" asp-action="CadastrarProcessar" method="post">
                <div class="acesso-campo">
                    <label asp-for="Nome" class="acesso-rotulo">Nome*</label>
                    <div class="input w-full">
                        <span class="text-muted"><partial name="_Icone" model='"user"' /></span>
                        <input asp-for="Nome" autocomplete="name" maxlength="200" class="grow" placeholder="Digite o seu nome" />
                    </div>
                    <span asp-validation-for="Nome" class="erro"></span>
                </div>

                <div class="acesso-campo">
                    <label asp-for="Email" class="acesso-rotulo">E-mail*</label>
                    <div class="input w-full">
                        <span class="text-muted"><partial name="_Icone" model='"mail"' /></span>
                        <input asp-for="Email" type="email" autocomplete="username" maxlength="150" class="grow" placeholder="Digite o seu e-mail" />
                    </div>
                    <span asp-validation-for="Email" class="erro"></span>
                </div>

                <div class="acesso-campo">
                    <label asp-for="Senha" class="acesso-rotulo">Senha*</label>
                    <div class="input w-full">
                        <span class="text-muted"><partial name="_Icone" model='"lock"' /></span>
                        <input asp-for="Senha" type="password" class="grow" autocomplete="new-password" placeholder="Mínimo de 6 caracteres" />
                        <button type="button" class="btn btn-ghost btn-sm btn-square acesso-olho" data-alternar-senha="Senha" aria-label="Mostrar senha" aria-pressed="false">
                            <span><partial name="_Icone" model='"eye"' /></span>
                            <span class="hidden"><partial name="_Icone" model='"eyeOff"' /></span>
                        </button>
                    </div>
                    <span asp-validation-for="Senha" class="erro"></span>
                </div>

                <div class="acesso-campo">
                    <label asp-for="ConfirmarSenha" class="acesso-rotulo">Confirmar senha*</label>
                    <div class="input w-full">
                        <span class="text-muted"><partial name="_Icone" model='"lock"' /></span>
                        <input asp-for="ConfirmarSenha" type="password" class="grow" autocomplete="new-password" placeholder="Repita a senha" />
                        <button type="button" class="btn btn-ghost btn-sm btn-square acesso-olho" data-alternar-senha="ConfirmarSenha" aria-label="Mostrar senha" aria-pressed="false">
                            <span><partial name="_Icone" model='"eye"' /></span>
                            <span class="hidden"><partial name="_Icone" model='"eyeOff"' /></span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmarSenha" class="erro"></span>
                </div>

                <button type="submit" class="btn btn-primary mt-6 w-full">Cadastrar <partial name="_Icone" model='"arrowRight"' /></button>
            </form>

            <a asp-controller="Login" asp-action="LoginExibir" class="btn btn-link acesso-link">Já tenho conta</a>
        </div>
    </section>
</div>
