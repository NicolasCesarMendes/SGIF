@model SGIF.Models.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    ViewData["Publica"] = true;
    ViewData["SemCabecalho"] = true;
}

<div class="acesso">
    <partial name="_Lateral" />

    <section class="acesso-area">
        <div class="acesso-form">
            <h1 class="acesso-h1">Entrar no <span class="destaque"><span>SGIF</span></span></h1>
            <p class="acesso-sub">Acesse com seu e-mail e senha para ver o monitoramento.</p>

            @if (TempData["Sucesso"] is string mensagemSucesso) { <div class="alert alert-success mt-4" role="status">@mensagemSucesso</div> }
            @if (ViewBag.Erro != null) { <div class="alert alert-error mt-4" role="alert">@ViewBag.Erro</div> }

            <form asp-controller="Login" asp-action="LoginProcessar" method="post">
                <div class="acesso-campo">
                    <label asp-for="Email" class="acesso-rotulo">E-mail*</label>
                    <div class="input w-full">
                        <span class="text-muted"><partial name="_Icone" model='"mail"' /></span>
                        <input asp-for="Email" type="email" class="grow" autocomplete="username" placeholder="Digite o seu e-mail" />
                    </div>
                    <span asp-validation-for="Email" class="erro"></span>
                </div>

                <div class="acesso-campo">
                    <label asp-for="Senha" class="acesso-rotulo">Senha*</label>
                    <div class="input w-full">
                        <span class="text-muted"><partial name="_Icone" model='"lock"' /></span>
                        <input asp-for="Senha" type="password" class="grow" autocomplete="current-password" placeholder="Digite a sua senha" />
                        <button type="button" class="btn btn-ghost btn-sm btn-square acesso-olho" data-alternar-senha="Senha" aria-label="Mostrar senha" aria-pressed="false">
                            <span><partial name="_Icone" model='"eye"' /></span>
                            <span class="hidden"><partial name="_Icone" model='"eyeOff"' /></span>
                        </button>
                    </div>
                    <span asp-validation-for="Senha" class="erro"></span>
                </div>

                <button type="submit" class="btn btn-primary mt-6 w-full">Entrar <partial name="_Icone" model='"arrowRight"' /></button>
            </form>

            <a asp-controller="Login" asp-action="CadastroExibir" class="btn btn-link acesso-link">Criar uma conta</a>
        </div>
    </section>
</div>
