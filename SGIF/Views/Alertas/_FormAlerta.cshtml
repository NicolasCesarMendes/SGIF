@model AlertaFormViewModel
@{
    AlertaItemViewModel a = Model.Alerta;

    string classeNivel = a.Nivel == "Critico" ? "badge-error" : "badge-warning";
}

<form asp-controller="Alertas" asp-action="Salvar" method="post">
    <div class="flex items-center justify-between border-b border-base-300 p-4">
        <h5 class="text-lg font-semibold">Alerta #@a.IdAlerta</h5>
        <button type="button" class="btn btn-ghost btn-sm btn-square" data-modal-close aria-label="Fechar"><partial name="_Icone" model='"x"' /></button>
    </div>

    <div class="space-y-4 p-4">
        <input type="hidden" name="id" value="@a.IdAlerta" />

        <dl class="grid grid-cols-12 mb-3">
            <dt class="sm:col-span-4">Nível</dt>
            <dd class="sm:col-span-8"><span class="badge @classeNivel">@AlertasViewModel.NomeNivel(a.Nivel)</span></dd>

            <dt class="sm:col-span-4">Ativo</dt>
            <dd class="sm:col-span-8">
                <a asp-controller="Ficha" asp-action="FichaExibir" asp-route-tipo="@a.TipoAtivo" asp-route-id="@a.IdAtivo">@a.Ativo</a>
            </dd>

            <dt class="sm:col-span-4">Sensor</dt>
            <dd class="sm:col-span-8">@a.Sensor</dd>

            <dt class="sm:col-span-4">Valor lido</dt>
            <dd class="sm:col-span-8 font-semibold">@a.ValorLido</dd>

            <dt class="sm:col-span-4">Data e hora</dt>
            <dd class="sm:col-span-8">@a.DataHora</dd>

            <dt class="sm:col-span-4">Descrição</dt>
            <dd class="sm:col-span-8">@a.Descricao</dd>

            <dt class="sm:col-span-4">Responsável</dt>
            <dd class="sm:col-span-8">@a.Responsavel</dd>

            @if (a.DataResolucao != null)
            {
                <dt class="sm:col-span-4">Resolvido em</dt>
                <dd class="sm:col-span-8">@a.DataResolucao</dd>
            }
        </dl>

        @if (Model.PodeAtualizar)
        {
            <label for="alertaStatus" class="label font-medium text-sm">Situação</label>
            <select name="status" id="alertaStatus" class="select w-full">
                @foreach (string situacao in AlertasViewModel.Situacoes)
                {
                    <option value="@situacao" selected="@(situacao == a.Status)">@AlertasViewModel.NomeSituacao(situacao)</option>
                }
            </select>
            <div class="text-sm text-muted">Ao assumir ou resolver, você passa a ser o responsável pelo alerta.</div>
        }
        else
        {
            <p class="mb-0"><span class="text-muted">Situação:</span> <strong>@AlertasViewModel.NomeSituacao(a.Status)</strong></p>
        }
    </div>

    <div class="flex justify-end gap-2 border-t border-base-300 p-4">
        <button type="button" class="btn btn-outline" data-modal-close>Fechar</button>
        @if (Model.PodeAtualizar)
        {
            <button type="submit" class="btn btn-primary">Salvar</button>
        }
    </div>
</form>
