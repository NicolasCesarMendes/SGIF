@model AlertasViewModel
@{
    ViewData["Title"] = "Alertas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">Alertas</h1>
    <span class="text-muted small">Críticos primeiro; alertas resolvidos ficam no fim da fila.</span>
</div>

<!-- Filtro por situação (Todos, Aberto, Em análise, Resolvido) -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(Model.Status == null ? "btn-primary" : "btn-outline-primary")"
       asp-action="Index">Todos <span class="badge bg-light text-dark">@Model.ContagemTotal</span></a>

    @foreach (string situacao in AlertasViewModel.Situacoes)
    {
        <a class="btn btn-sm @(Model.Status == situacao ? "btn-primary" : "btn-outline-primary")"
           asp-action="Index" asp-route-status="@situacao">@AlertasViewModel.NomeSituacao(situacao) <span class="badge bg-light text-dark">@Model.ContagemDe(situacao)</span></a>
    }
</div>

@if (Model.Itens.Count == 0)
{
    <div class="alert alert-light border">Nenhum alerta encontrado para este filtro.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nível</th>
                    <th>Ativo</th>
                    <th>Sensor</th>
                    <th>Valor lido</th>
                    <th>Data e hora</th>
                    <th>Situação</th>
                    <th>Responsável</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AlertaItemViewModel a in Model.Itens)
                {
                    string classeNivel = a.Nivel == "Critico" ? "bg-danger" : "bg-warning text-dark";
                    string classeSituacao = a.Status == "Resolvido" ? "bg-success"
                                          : a.Status == "Em analise" ? "bg-info text-dark" : "bg-dark";
                    string classeLinha = a.Nivel == "Critico" && a.Status != "Resolvido" ? "table-danger" : "";

                    <tr class="@classeLinha">
                        <td><span class="badge @classeNivel">@AlertasViewModel.NomeNivel(a.Nivel)</span></td>
                        <td>
                            <a asp-controller="Ficha" asp-action="Index" asp-route-tipo="@a.TipoAtivo" asp-route-id="@a.IdAtivo">@a.Ativo</a>
                        </td>
                        <td>@a.Sensor</td>
                        <td class="fw-semibold">@a.ValorLido</td>
                        <td class="text-nowrap">@a.DataHora</td>
                        <td><span class="badge @classeSituacao">@AlertasViewModel.NomeSituacao(a.Status)</span></td>
                        <td>@a.Responsavel</td>
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm @(Model.PodeAtualizar ? "btn-outline-primary" : "btn-outline-secondary")"
                                    data-modal-url="@Url.Action("FormAlerta", "Alertas", new { id = a.IdAlerta })" data-modal-grande>
                                @(Model.PodeAtualizar ? "Atualizar" : "Detalhes")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginação -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">Página @Model.Pagina de @Model.TotalPaginas (@Model.TotalFiltrado alertas)</span>

        <div class="btn-group btn-group-sm">
            @if (Model.Pagina > 1)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="@Model.Status" asp-route-pagina="@(Model.Pagina - 1)">&larr; Anterior</a>
            }
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="@Model.Status" asp-route-pagina="@(Model.Pagina + 1)">Próxima &rarr;</a>
            }
        </div>
    </div>
}
