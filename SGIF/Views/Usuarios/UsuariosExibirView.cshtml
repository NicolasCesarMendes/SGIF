@model UsuariosViewModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="flex flex-wrap justify-between items-center gap-2 mb-3">
    <h1 class="text-2xl m-0">Usuários</h1>
    <button type="button" class="btn btn-primary btn-sm"
            data-modal-url="@Url.Action("FormUsuario", "Usuarios")">+ Novo usuário</button>
</div>

<div class="overflow-x-auto">
    <table class="table table-zebra">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Perfil</th>
                <th>Situação</th>
                <th class="text-right">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Usuario u in Model.Itens)
            {
                <tr>
                    <td class="font-semibold">@u.Nome</td>
                    <td>@u.Email</td>
                    <td>@Usuario.NomePerfil(u.NivelAcesso)</td>
                    <td>
                        <span class="badge @(u.Ativo ? "badge-success" : "badge-ghost")">@(u.Ativo ? "Ativo" : "Inativo")</span>
                    </td>
                    <td class="text-right text-nowrap">
                        @if (u.IdUsuario == Model.IdLogado)
                        {
                            <span class="text-muted text-sm">Sua conta (use <a href="#" data-modal-url="@Url.Action("Modal", "Conta")" data-modal-grande>Minha conta</a>)</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline"
                                    data-modal-url="@Url.Action("FormUsuario", "Usuarios", new { id = u.IdUsuario })">Editar</button>

                            @if (Usuario.EhPadrao(u.IdUsuario))
                            {
                                @* Usuários de teste padrão (ids 1, 2 e 3) não podem ser excluídos *@
                                <button type="button" class="btn btn-sm btn-outline btn-error" disabled
                                        title="Usuário de teste padrão: não pode ser excluído">Excluir</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline btn-error"
                                        data-excluir-url="@Url.Action("Excluir", "Usuarios")" data-excluir-id="@u.IdUsuario"
                                        data-excluir-texto="Deseja realmente excluir o usuário @(u.Nome)? Esta ação não pode ser desfeita.">Excluir</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
