@model UsuariosViewModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">Usuários</h1>
    <a class="btn btn-primary btn-sm" asp-action="CriarExibir">+ Novo usuário</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Perfil</th>
                <th>Situação</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Usuario u in Model.Itens)
            {
                <tr>
                    <td class="fw-semibold">@u.Nome</td>
                    <td>@u.Email</td>
                    <td>@Usuario.NomePerfil(u.NivelAcesso)</td>
                    <td>
                        <span class="badge @(u.Ativo ? "bg-success" : "bg-secondary")">@(u.Ativo ? "Ativo" : "Inativo")</span>
                    </td>
                    <td class="text-end text-nowrap">
                        @if (u.IdUsuario == Model.IdLogado)
                        {
                            <span class="text-muted small">Sua conta (use <a asp-controller="Conta" asp-action="Index">Minha conta</a>)</span>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditarExibir" asp-route-id="@u.IdUsuario">Editar</a>

                            <form asp-action="AlterarAtivoProcessar" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.IdUsuario" />
                                <input type="hidden" name="ativo" value="@((!u.Ativo).ToString().ToLower())" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(u.Ativo ? "Desativar" : "Ativar")</button>
                            </form>

                            <!-- Mensagem fixa de propósito: nada digitado pelos usuários entra em código JavaScript -->
                            <form asp-action="ExcluirProcessar" method="post" class="d-inline"
                                  onsubmit="return confirm('Deseja realmente excluir este usuário? Esta ação não pode ser desfeita.');">
                                <input type="hidden" name="id" value="@u.IdUsuario" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
