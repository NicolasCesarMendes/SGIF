@model UsuariosViewModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">Usuários</h1>
    <button type="button" class="btn btn-primary btn-sm"
            data-modal-url="@Url.Action("FormUsuario", "Usuarios")">+ Novo usuário</button>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Perfil</th>
                <th>Situação</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Usuario u in Model.Itens)
            {
                <tr>
                    <td class="fw-semibold">@u.Nome</td>
                    <td>@u.Email</td>
                    <td>@Usuario.NomePerfil(u.NivelAcesso)</td>
                    <td>
                        <span class="badge @(u.Ativo ? "bg-success" : "bg-secondary")">@(u.Ativo ? "Ativo" : "Inativo")</span>
                    </td>
                    <td class="text-end text-nowrap">
                        @if (u.IdUsuario == Model.IdLogado)
                        {
                            <span class="text-muted small">Sua conta (use <a href="#" data-modal-url="@Url.Action("Modal", "Conta")" data-modal-grande>Minha conta</a>)</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-modal-url="@Url.Action("FormUsuario", "Usuarios", new { id = u.IdUsuario })">Editar</button>

                            <form asp-action="AlterarAtivoProcessar" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.IdUsuario" />
                                <input type="hidden" name="ativo" value="@((!u.Ativo).ToString().ToLower())" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(u.Ativo ? "Desativar" : "Ativar")</button>
                            </form>

                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-excluir-url="@Url.Action("Excluir", "Usuarios")" data-excluir-id="@u.IdUsuario"
                                    data-excluir-texto="Deseja realmente excluir o usuário @(u.Nome)? Esta ação não pode ser desfeita.">Excluir</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
