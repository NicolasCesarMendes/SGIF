@model UsuarioFormViewModel
@{
    bool novo = Model.IdUsuario == 0;
    ViewData["Title"] = novo ? "Novo usuário" : "Editar usuário";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(novo ? "CriarProcessar" : "EditarProcessar")" method="post" class="card card-body" style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <input type="hidden" asp-for="IdUsuario" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" maxlength="200" />
        <span asp-validation-for="Nome" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-mail</label>
        <input asp-for="Email" type="email" class="form-control" maxlength="150" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NivelAcesso" class="form-label">Perfil</label>
        <select asp-for="NivelAcesso" class="form-select">
            @foreach (int nivel in new[] { Usuario.Funcionario, Usuario.Manutencao, Usuario.Administrador })
            {
                <option value="@nivel">@Usuario.NomePerfil(nivel)</option>
            }
        </select>
        <span asp-validation-for="NivelAcesso" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Senha" class="form-label">@(novo ? "Senha" : "Nova senha (deixe em branco para manter a atual)")</label>
        <input asp-for="Senha" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Senha" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
