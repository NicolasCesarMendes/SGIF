@using SGIF.Classes
@model RelatorioViewModel
@{
    ViewData["Title"] = "Relatórios";

    string Valor(decimal? v) => EntradaNumerica.Formatar(v);
    string Horas(double? h) => h.HasValue
        ? h.Value.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("pt-BR")) + " h"
        : "-";

    string ativoSelecionado = Model.IdAtivo.HasValue ? Model.TipoAtivo + ":" + Model.IdAtivo.Value : "";
}

<h1 class="text-2xl mb-1">Relatórios</h1>
<p class="text-muted mb-3">Estatísticas das leituras e dos alertas, com comparativo mensal.</p>

<!-- Filtros -->
<form method="get" asp-action="RelatoriosExibir" class="grid grid-cols-12 gap-2 items-end mb-4" id="formFiltros">
    <input type="hidden" name="idAtivo" id="idAtivo" value="@Model.IdAtivo" />

    <div class="col-span-12 sm:col-span-6 lg:col-span-2">
        <label class="label font-medium text-sm text-sm mb-1" for="tipoAtivo">Tipo de ativo</label>
        <select name="tipoAtivo" id="tipoAtivo" class="select w-full">
            <option value="">Todos</option>
            <option value="Locomotiva" selected="@(Model.TipoAtivo == "Locomotiva")">Locomotivas</option>
            <option value="Vagao" selected="@(Model.TipoAtivo == "Vagao")">Vagões</option>
        </select>
    </div>

    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <label class="label font-medium text-sm text-sm mb-1" for="ativoEspecifico">Ativo específico</label>
        <select id="ativoEspecifico" class="select w-full">
            <option value="">Todos</option>
            @foreach (OpcaoDeAtivo o in Model.Ativos)
            {
                string valor = o.TipoAtivo + ":" + o.IdAtivo;
                <option value="@valor" selected="@(valor == ativoSelecionado)">@o.Texto</option>
            }
        </select>
    </div>

    <div class="col-span-6 lg:col-span-2">
        <label class="label font-medium text-sm text-sm mb-1" for="tipoSensor">Tipo de sensor</label>
        <select name="tipoSensor" id="tipoSensor" class="select w-full">
            <option value="">Todos</option>
            @foreach (string tipo in TiposSensor.Todos)
            {
                <option value="@tipo" selected="@(Model.TipoSensor == tipo)">@TiposSensor.Nome(tipo)</option>
            }
        </select>
    </div>

    <div class="col-span-6 lg:col-span-2">
        <label class="label font-medium text-sm text-sm mb-1" for="periodo">Período</label>
        <select name="periodo" id="periodo" class="select w-full">
            @foreach (var p in RelatorioViewModel.Periodos)
            {
                <option value="@p.Codigo" selected="@(Model.Periodo == p.Codigo)">@p.Texto</option>
            }
        </select>
    </div>

    <div class="col-span-6 lg:col-span-1">
        <label class="label font-medium text-sm text-sm mb-1" for="meses">Meses</label>
        <select name="meses" id="meses" class="select w-full">
            @foreach (int m in new[] { 3, 6, 12 })
            {
                <option value="@m" selected="@(Model.Meses == m)">@m</option>
            }
        </select>
    </div>

    <div class="col-span-6 lg:col-span-2 flex gap-2">
        <button type="submit" class="btn btn-primary flex-1">Filtrar</button>
        <a class="btn btn-outline" asp-action="RelatoriosExibir">Limpar</a>
    </div>
</form>

<!-- Alertas no período -->
<h2 class="text-lg">Alertas no período</h2>
<div class="grid grid-cols-12 gap-2 mb-4">
    @foreach (var (rotulo, quantidade) in new[]
    {
        ("Total", Model.Alertas.Total),
        ("Críticos", Model.Alertas.Criticos),
        ("Atenção", Model.Alertas.Atencao),
        ("Abertos", Model.Alertas.Abertos),
        ("Em análise", Model.Alertas.EmAnalise),
        ("Resolvidos", Model.Alertas.Resolvidos)
    })
    {
        <div class="col-span-6 md:col-span-4 lg:col-span-2">
            <div class="card card-border bg-base-100 text-center">
                <div class="card-body py-2">
                    <div class="text-3xl font-semibold">@quantidade</div>
                    <div class="text-sm text-muted">@rotulo</div>
                </div>
            </div>
        </div>
    }
</div>
<p class="text-muted text-sm -mt-2 mb-4">
    Tempo médio para resolver um alerta: <strong>@Horas(Model.Alertas.HorasMediasParaResolver)</strong>
</p>

<!-- Estatísticas por tipo de sensor -->
<h2 class="text-lg">Estatísticas das leituras</h2>
@if (Model.Estatisticas.Count == 0)
{
    <div class="alert bg-base-100 border">Sem leituras no período para os filtros escolhidos.</div>
}
else
{
    <div class="overflow-x-auto mb-4">
        <table class="table table-xs">
            <thead>
                <tr>
                    <th>Tipo de sensor</th>
                    <th class="text-right">Sensores</th>
                    <th class="text-right">Leituras</th>
                    <th class="text-right">Mínimo</th>
                    <th class="text-right">Máximo</th>
                    <th class="text-right">Média</th>
                    <th class="text-right">Desvio-padrão</th>
                </tr>
            </thead>
            <tbody>
                @foreach (EstatisticaTipo e in Model.Estatisticas)
                {
                    string unidade = TiposSensor.Unidade(e.TipoSensor);

                    <tr>
                        <td class="font-semibold">@TiposSensor.Nome(e.TipoSensor) <span class="text-muted text-sm">@unidade</span></td>
                        <td class="text-right">@e.Sensores</td>
                        <td class="text-right">@e.Quantidade</td>
                        <td class="text-right">@Valor(e.Minimo)</td>
                        <td class="text-right">@Valor(e.Maximo)</td>
                        <td class="text-right">@Valor(e.Media)</td>
                        <td class="text-right">@Valor(e.Desvio)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Comparativo mensal -->
<h2 class="text-lg">Comparativo mensal (últimos @Model.Meses meses)</h2>
<div class="grid grid-cols-12 gap-4">
    <div class="col-span-12 xl:col-span-8">
        <div class="overflow-x-auto">
            <table class="table table-xs">
                <thead>
                    <tr>
                        <th>Mês</th>
                        <th>Tipo de sensor</th>
                        <th class="text-right">Leituras</th>
                        <th class="text-right">Média</th>
                        <th class="text-right">Máximo</th>
                        <th class="text-right">Variação da média</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ComparativoMes mes in Model.ComparativoMensal)
                    {
                        if (mes.Tipos.Count == 0)
                        {
                            <tr class="text-muted">
                                <td>@mes.Rotulo</td>
                                <td colspan="5">Sem leituras</td>
                            </tr>
                        }

                        @foreach (ComparativoTipo t in mes.Tipos)
                        {
                            <tr>
                                <td>@mes.Rotulo</td>
                                <td>@TiposSensor.Nome(t.TipoSensor)</td>
                                <td class="text-right">@t.Quantidade</td>
                                <td class="text-right">@Valor(t.Media)</td>
                                <td class="text-right">@Valor(t.Maximo)</td>
                                <td class="text-right">
                                    @if (t.VariacaoMediaPercentual.HasValue)
                                    {
                                        @((t.VariacaoMediaPercentual.Value >= 0 ? "+" : "") + Valor(t.VariacaoMediaPercentual) + "%")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted text-sm">A variação compara a média com a do último mês que teve leituras do mesmo tipo de sensor.</p>
    </div>

    <div class="col-span-12 xl:col-span-4">
        <div class="overflow-x-auto">
            <table class="table table-xs">
                <thead>
                    <tr>
                        <th>Mês</th>
                        <th class="text-right">Alertas críticos</th>
                        <th class="text-right">Alertas de atenção</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ComparativoMes mes in Model.ComparativoMensal)
                    {
                        <tr>
                            <td>@mes.Rotulo</td>
                            <td class="text-right">@mes.AlertasCriticos</td>
                            <td class="text-right">@mes.AlertasAtencao</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<p class="text-muted text-sm mt-3">Gerado em @Model.GeradoEm.ToString("dd/MM/yyyy HH:mm:ss").</p>
