@{
    Layout = "_LayoutDaisy";
    ViewData["Title"] = "Sobre";

    // Conteúdo institucional fixo (não depende do banco)
    var faz = new[]
    {
        "Cadastro, login e níveis de usuário, para garantir a segurança do acesso",
        "Cadastro e gestão de locomotivas, vagões e sensores de temperatura e vibração",
        "Consulta de dados atuais e históricos coletados pelos sensores",
        "Gráficos, indicadores e tendências sobre o estado dos equipamentos",
        "Alertas quando os dados indicam possíveis anomalias",
        "Estatísticas e análises dos dados, com apoio de ciência de dados",
        "Filtros de consulta por vagão, locomotiva e período",
    };
    var naoFaz = new[]
    {
        "Controlar ou operar as locomotivas e os vagões",
        "Substituir os sistemas já existentes nas empresas ferroviárias",
        "Realizar a manutenção física dos equipamentos",
    };
    var perfis = new[]
    {
        (Papel: "Administrador", Nivel: "Alto", Descricao: "Gerencia usuários, locomotivas, vagões e sensores, com acesso total ao sistema."),
        (Papel: "Funcionário da Manutenção", Nivel: "Médio", Descricao: "Visualiza dados e alertas e pode fazer pequenas alterações de informação e associação."),
        (Papel: "Funcionário", Nivel: "Baixo", Descricao: "Consulta as informações de monitoramento dos equipamentos, sem realizar alterações."),
    };
    var listas = new[] { (Id: "faz", Titulo: "O que o sistema faz", Itens: faz, Cor: "bg-success"), (Id: "nao-faz", Titulo: "O que o sistema não faz", Itens: naoFaz, Cor: "bg-error") };
}

<div class="mb-10"><partial name="_CabecalhoPagina" model='("Contexto", "Sobre o SGIF", "Ferrovia Telemetria é a interface do SGIF — Sistema de Gestão Industrial Ferroviário —, desenvolvida para o acompanhamento de locomotivas e vagões por meio de sensores de temperatura e vibração.")' /></div>

<div class="grid grid-cols-1 gap-4 min-[960px]:grid-cols-2">
    @foreach (var lista in listas)
    {
        <section class="card card-border bg-base-100" aria-labelledby="titulo-@lista.Id">
            <div class="card-body">
                <h2 id="titulo-@lista.Id" class="text-[1.4rem]">@lista.Titulo</h2>
                <ul class="mt-2 grid gap-3">
                    @foreach (var item in lista.Itens)
                    {
                        <li class="flex gap-3"><span class="mt-2 size-1.5 shrink-0 rounded-full @lista.Cor" aria-hidden="true"></span><span class="text-muted">@item</span></li>
                    }
                </ul>
            </div>
        </section>
    }
</div>

<section class="card card-border mt-6 bg-base-100" aria-labelledby="titulo-perfis">
    <div class="card-body">
        <h2 id="titulo-perfis" class="text-[1.4rem]">Perfis de acesso</h2>
        <p class="text-muted">O acesso ao SGIF é organizado em três níveis, cada um com permissões diferentes sobre os dados da frota.</p>
        <div class="mt-2 overflow-x-auto">
            <table class="table min-w-[680px]">
                <caption class="sr-only">Perfis de usuário do SGIF e seu nível de acesso</caption>
                <thead><tr><th scope="col">Perfil</th><th scope="col">Nível de acesso</th><th scope="col">O que pode fazer</th></tr></thead>
                <tbody>
                    @foreach (var p in perfis)
                    {
                        <tr><th scope="row">@p.Papel</th><td class="font-mono text-[0.8rem]">@p.Nivel</td><td class="text-muted">@p.Descricao</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="card card-border mt-6 bg-base-100" aria-labelledby="titulo-metodologia">
    <div class="card-body">
        <h2 id="titulo-metodologia" class="text-[1.4rem]">Metodologia</h2>
        <p class="text-muted">O desenvolvimento segue Scrumban, unindo o ritmo iterativo do Scrum com o fluxo contínuo do Kanban para organizar as entregas do projeto.</p>
    </div>
</section>
