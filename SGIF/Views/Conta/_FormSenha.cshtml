@model SenhaViewModel

<form asp-controller="Conta" asp-action="AlterarSenhaProcessar" method="post">
    <div class="mb-3">
        <label asp-for="SenhaAtual" class="label font-medium text-sm">Senha atual</label>
        <input asp-for="SenhaAtual" type="password" class="input w-full" autocomplete="current-password" />
        <span asp-validation-for="SenhaAtual" class="text-error text-sm"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NovaSenha" class="label font-medium text-sm">Nova senha</label>
        <input asp-for="NovaSenha" type="password" class="input w-full" autocomplete="new-password" />
        <span asp-validation-for="NovaSenha" class="text-error text-sm"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarNovaSenha" class="label font-medium text-sm">Confirmar nova senha</label>
        <input asp-for="ConfirmarNovaSenha" type="password" class="input w-full" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarNovaSenha" class="text-error text-sm"></span>
    </div>

    <button type="submit" class="btn btn-primary">Alterar senha</button>
</form>
