@{
    string? nome = Context.Session.GetString("nome");
    int.TryParse(Context.Session.GetString("nivelAcesso"), out int nivel);
    bool logado = !string.IsNullOrEmpty(nome);
    bool publica = ViewData["Publica"] as bool? ?? false;
    bool semCabecalho = ViewData["SemCabecalho"] as bool? ?? false;
    string controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string actionAtual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var itens = new List<(string Texto, string Controller, string Action, bool Pronto)>
    {
        ("Painel Operacional", "Home", "PainelOperacionalExibir", true),
        ("Frota", "Frota", "FrotaExibir", true),
        ("Alertas", "Alertas", "AlertasExibir", true),
        ("Manutenção", "Manutencao", "ManutencaoExibir", true),
        ("Relatórios", "Relatorios", "RelatoriosExibir", true),
        ("Sobre", "Home", "SobreExibir", true),
        ("Equipe", "Home", "EquipeExibir", true)
    };
    if (nivel == Usuario.Administrador) { itens.Add(("Usuários", "Usuarios", "UsuariosExibir", true)); }
    bool Ativo(string controller, string acao) =>
        controller == "Home"
            ? controllerAtual == "Home" && string.Equals(actionAtual, acao, StringComparison.OrdinalIgnoreCase)
            : string.Equals(controllerAtual, controller, StringComparison.OrdinalIgnoreCase)
              || (controller == "Frota" && (controllerAtual == "Ficha" || controllerAtual == "Sensores"));
    var sucesso = TempData["Sucesso"] as string;
    var erro = TempData["Erro"] as string;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SGIF: monitoramento de locomotivas e vagões, alertas e manutenção preditiva." />
    <title>@ViewData["Title"] - SGIF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-base-200 font-sans text-base-content">
    <a href="#conteudo" class="sr-only z-[100] rounded-field border border-base-300 bg-base-100 px-4 py-3 focus:not-sr-only focus:absolute focus:left-4 focus:top-4">Pular para o conteúdo</a>

    @if (!semCabecalho)
    {
        @if (publica)
        {
            <header class="border-b border-base-300 bg-base-100">
                <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between px-5 py-3 sm:px-8">
                    <a asp-controller="Home" asp-action="LandingPageExibir" class="flex items-center gap-2.5 font-serif text-xl" aria-label="SGIF - início">
                        <span class="text-primary"><partial name="_Icone" model='"train"' /></span>SGIF
                    </a>
                    <a asp-controller="Login" asp-action="LoginExibir" class="btn btn-primary rounded-full">Abrir painel</a>
                </div>
            </header>
        }
        else if (logado)
        {
            <header class="sticky top-0 z-40 border-b border-base-300 bg-base-200/90 backdrop-blur">
                <div class="mx-auto flex h-16 w-full max-w-[1440px] items-center gap-4 px-5 sm:px-8">
                    <a asp-controller="Home" asp-action="PainelOperacionalExibir" class="flex shrink-0 items-center gap-2.5 text-primary">
                        <partial name="_Icone" model='"train"' />
                        <span class="whitespace-nowrap font-serif text-xl tracking-tight text-base-content">Ferrovia <em>Telemetria</em></span>
                    </a>
                    <nav aria-label="Principal" class="mr-auto ml-8 hidden min-[1120px]:block">
                        <ul class="menu menu-horizontal gap-1 p-0">
                            @foreach (var item in itens)
                            {
                                <li><a asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(Ativo(item.Controller, item.Action) ? "page" : null)" class="whitespace-nowrap text-muted hover:text-base-content aria-[current=page]:bg-base-300/60 aria-[current=page]:font-semibold aria-[current=page]:text-base-content">@item.Texto</a></li>
                            }
                        </ul>
                    </nav>
                    <div class="ml-auto hidden shrink-0 items-center gap-4 min-[1120px]:flex">
                        <a href="#perfil" class="btn btn-ghost btn-circle" aria-label="Abrir perfil de @nome" title="Minha conta" data-modal-url="@Url.Action("Modal", "Conta")" data-modal-grande>
                            <partial name="_Icone" model='"user"' />
                        </a>
                        <form asp-controller="Login" asp-action="SairProcessar" method="post"><button type="submit" class="btn btn-outline rounded-full">Sair</button></form>
                    </div>
                    <details class="dropdown dropdown-end ml-auto min-[1120px]:hidden">
                        <summary class="btn btn-ghost btn-square" aria-label="Abrir menu"><partial name="_Icone" model='"menu"' /></summary>
                        <ul class="menu dropdown-content z-50 mt-2 w-64 rounded-box border border-base-300 bg-base-100 p-2">
                            @foreach (var item in itens)
                            {
                                <li><a asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(Ativo(item.Controller, item.Action) ? "page" : null)" class="text-muted aria-[current=page]:bg-base-300/60 aria-[current=page]:font-semibold aria-[current=page]:text-base-content">@item.Texto</a></li>
                            }
                            <li class="mt-2 border-t border-base-300 px-3 pt-3 text-sm text-muted">@nome · @Usuario.NomePerfil(nivel)</li>
                            <li><a href="#perfil" data-modal-url="@Url.Action("Modal", "Conta")" data-modal-grande><partial name="_Icone" model='"user"' /> Minha conta</a></li>
                            <li><form asp-controller="Login" asp-action="SairProcessar" method="post" class="p-0"><button type="submit" class="w-full px-3 py-2 text-left text-primary underline">Sair</button></form></li>
                        </ul>
                    </details>
                </div>
            </header>
        }
    }

    @if (!string.IsNullOrEmpty(sucesso) || !string.IsNullOrEmpty(erro))
    {
        <div class="toast toast-end toast-bottom z-50">
            @if (!string.IsNullOrEmpty(sucesso))
            {
                <div data-vue="fechavel"><div v-if="aberto" class="alert alert-success" role="status"><span v-pre>@sucesso</span><button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Fechar mensagem" v-on:click="aberto = false"><partial name="_Icone" model='"x"' /></button></div></div>
            }
            @if (!string.IsNullOrEmpty(erro))
            {
                <div data-vue="fechavel"><div v-if="aberto" class="alert alert-error" role="alert"><span v-pre>@erro</span><button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Fechar mensagem" v-on:click="aberto = false"><partial name="_Icone" model='"x"' /></button></div></div>
            }
        </div>
    }

    <main id="conteudo" tabindex="-1" class="flex flex-1 flex-col">
        @if (publica) { @RenderBody() } else { <div class="pagina">@RenderBody()</div> }
    </main>
    <footer class="border-t border-base-300 bg-base-300/40 px-5 py-4 text-center text-xs text-muted">&copy; 2026 - SGIF - Sistema de Gestão Industrial Ferroviário</footer>

    @if (logado)
    {
        <dialog class="modal" id="modalForm" aria-label="Formulário">
            <div class="modal-box max-w-2xl p-0" id="modalFormDialog"><div id="modalFormCorpo"></div></div>
            <form method="dialog" class="modal-backdrop"><button aria-label="Fechar">Fechar</button></form>
        </dialog>
        <dialog class="modal" id="modalConfirmar" aria-labelledby="confirmarTitulo">
            <div class="modal-box max-w-lg"><form id="formConfirmar" method="post">
                @Html.AntiForgeryToken()<input type="hidden" name="id" id="confirmarId" />
                <h2 class="text-xl font-semibold" id="confirmarTitulo">Confirmar exclusão</h2><p class="py-4" id="confirmarTexto"></p>
                <div class="alert alert-error mb-4 hidden" id="confirmarErro" role="alert"></div>
                <div class="flex justify-end gap-2"><button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button><button type="submit" class="btn btn-error">Excluir</button></div>
            </form></div>
            <form method="dialog" class="modal-backdrop"><button aria-label="Fechar">Fechar</button></form>
        </dialog>
    }

    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
