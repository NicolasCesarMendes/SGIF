@{
    string? nome = Context.Session.GetString("nome");
    int.TryParse(Context.Session.GetString("nivelAcesso"), out int nivel);
    bool logado = !string.IsNullOrEmpty(nome);
    string controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Menu principal. Pronto = false deixa o item desativado até a tela existir
    // (quando a tela ficar pronta, é só trocar para true).
    var itens = new List<(string Texto, string Controller, string Action, bool Pronto)>
    {
        ("Tela Inicial", "Home", "Index", true),
        ("Frota", "Frota", "Index", true),
        ("Alertas", "Alertas", "Index", false),
        ("Manutenção", "Manutencao", "Index", false),
        ("Relatórios", "Relatorios", "Index", false),
        ("Sobre", "Sobre", "Index", false),
        ("Equipe", "Equipe", "Index", false)
    };

    // Só o Administrador vê "Usuários"
    if (nivel == Usuario.Administrador)
    {
        itens.Add(("Usuários", "Usuarios", "Index", true));
    }
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGIF</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SGIF.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="@(logado ? "Index" : "LandingPage")">SGIF</a>

                @if (logado)
                {
                    <!-- No celular o menu fica recolhido atrás deste botão -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                            aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="menuPrincipal">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            @foreach (var item in itens)
                            {
                                // A Ficha do ativo e os Sensores fazem parte da Frota: mantêm "Frota" destacado
                                bool ativo = string.Equals(controllerAtual, item.Controller, StringComparison.OrdinalIgnoreCase)
                                    || (item.Controller == "Frota" && (controllerAtual == "Ficha" || controllerAtual == "Sensores"));

                                <li class="nav-item">
                                    @if (item.Pronto)
                                    {
                                        <a class="nav-link @(ativo ? "active fw-semibold" : "")"
                                           asp-controller="@item.Controller" asp-action="@item.Action">@item.Texto</a>
                                    }
                                    else
                                    {
                                        <span class="nav-link disabled" title="Em desenvolvimento">@item.Texto</span>
                                    }
                                </li>
                            }
                        </ul>

                        <!-- Área do usuário -->
                        <div class="d-flex align-items-center gap-3">
                            <!-- O nome leva para "Minha conta" (RF14) -->
                            <a href="#" class="text-lg-end lh-sm text-decoration-none text-body" title="Minha conta"
                               data-modal-url="@Url.Action("Modal", "Conta")" data-modal-grande>
                                <div class="fw-semibold">@nome</div>
                                <small class="text-muted">@Usuario.NomePerfil(nivel)</small>
                            </a>
                            <form asp-controller="Login" asp-action="SairProcessar" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @* Mensagens enviadas pelos controllers (TempData), exibidas uma única vez *@
            @if (TempData["Sucesso"] is string mensagemSucesso)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensagemSucesso
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @if (TempData["Erro"] is string mensagemErro)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @mensagemErro
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SGIF - Sistema de Gestão Industrial Ferroviário
        </div>
    </footer>

    @if (logado)
    {
        <!-- Modais do sistema: o conteúdo dos formulários é carregado por fetch (wwwroot/js/modais.js) -->
        <div class="modal fade" id="modalForm" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" id="modalFormDialog">
                <div class="modal-content" id="modalFormCorpo"></div>
            </div>
        </div>

        <!-- Confirmação de exclusão (usada por Usuários e Sensores) -->
        <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form id="formConfirmar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="confirmarId" />

                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar exclusão</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0" id="confirmarTexto"></p>
                            <div class="alert alert-danger mt-3 mb-0 d-none" id="confirmarErro"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Excluir</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modais.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
