@{
    string? nome = Context.Session.GetString("nome");
    bool logado = !string.IsNullOrEmpty(nome);
    bool publica = ViewData["Publica"] as bool? ?? false;
    bool semCabecalho = ViewData["SemCabecalho"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SGIF: monitoramento de locomotivas e vagões, alertas e manutenção preditiva." />
    <title>@ViewData["Title"] - SGIF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-base-200 font-sans text-base-content">
    <a href="#conteudo" class="sr-only z-[100] rounded-field border border-base-300 bg-base-100 px-4 py-3 focus:not-sr-only focus:absolute focus:left-4 focus:top-4">Pular para o conteúdo</a>

    @if (!semCabecalho)
    {
        @if (publica) { <partial name="_CabecalhoLanding" /> } else { <partial name="_Cabecalho" /> }
    }
    <partial name="_Mensagens" />

    <main id="conteudo" tabindex="-1" class="flex flex-1 flex-col">
        @if (publica) { @RenderBody() } else { <div class="pagina">@RenderBody()</div> }
    </main>

    <partial name="_Rodape" />

    @if (logado)
    {
        <dialog class="modal" id="modalForm" aria-label="Formulário">
            <div class="modal-box max-w-2xl p-0" id="modalFormDialog">
                <div id="modalFormCorpo"></div>
            </div>
            <form method="dialog" class="modal-backdrop"><button aria-label="Fechar">Fechar</button></form>
        </dialog>
        <dialog class="modal" id="modalConfirmar" aria-labelledby="confirmarTitulo">
            <div class="modal-box max-w-lg">
                <form id="formConfirmar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="confirmarId" />
                    <h2 class="text-xl font-semibold" id="confirmarTitulo">Confirmar exclusão</h2>
                    <p class="py-4" id="confirmarTexto"></p>
                    <div class="alert alert-error mb-4 hidden" id="confirmarErro" role="alert"></div>
                    <div class="flex justify-end gap-2">
                        <button type="button" class="btn btn-ghost" data-modal-close>Cancelar</button>
                        <button type="submit" class="btn btn-error">Excluir</button>
                    </div>
                </form>
            </div>
            <form method="dialog" class="modal-backdrop"><button aria-label="Fechar">Fechar</button></form>
        </dialog>
    }

    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
