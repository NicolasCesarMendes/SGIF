@* Ícones de traço. Uso: <partial name="_Icone" model='"mail"' /> (herdam a cor e o tamanho do texto) *@
@model string
<svg class="size-[1.15em] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Model)
    {
        case "train": <path d="M4 3h16v12H4zM4 9h16M7 15v2M17 15v2M6 21l2-3M18 21l-2-3" /><circle cx="8.5" cy="12" r="1.1" fill="currentColor" stroke="none" /><circle cx="15.5" cy="12" r="1.1" fill="currentColor" stroke="none" /> break;
        case "user": <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /> break;
        case "mail": <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /> break;
        case "lock": <rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /> break;
        case "eye": <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /> break;
        case "eyeOff": <path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.2M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.4-1" /> break;
        case "arrowRight": <path d="M5 12h14M13 6l6 6-6 6" /> break;
        case "arrowLeft": <path d="M19 12H5M11 18l-6-6 6-6" /> break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h16" /> break;
        case "x": <path d="M5 5l14 14M19 5L5 19" /> break;
    }
</svg>
