@model FichaViewModel
@{
    ViewData["Title"] = Model.NomeTipo + " " + Model.Numero;

    string classeEstado = Model.Estado switch
    {
        "Ativo" => "bg-success",
        "Em manutencao" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<a class="btn btn-sm btn-outline-secondary mb-3" asp-controller="Frota" asp-action="Index">&larr; Toda a frota</a>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">@Model.NomeTipo @Model.Numero</h1>
    <span class="badge @classeEstado">@FrotaViewModel.NomeEstado(Model.Estado)</span>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            @foreach (var (rotulo, valor) in Model.Detalhes)
            {
                <dt class="col-6 col-md-3">@rotulo</dt>
                <dd class="col-6 col-md-3">@valor</dd>
            }
        </dl>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h2 class="h5 m-0">Sensores</h2>

    @if (Model.PodeEditar)
    {
        <button type="button" class="btn btn-primary btn-sm"
                data-modal-url="@Url.Action("FormSensor", "Sensores", new { tipoAtivo = Model.Tipo, idAtivo = Model.Id })">+ Novo sensor</button>
    }
</div>

@if (Model.Sensores.Count == 0)
{
    <div class="alert alert-light border">Nenhum sensor associado a este ativo.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Modelo</th>
                    <th>Faixa de medição</th>
                    <th>Limite de atenção</th>
                    <th>Limite crítico</th>
                    <th>Última leitura</th>
                    @if (Model.PodeEditar)
                    {
                        <th class="text-end">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (SensorItemViewModel s in Model.Sensores)
                {
                    <tr class="@(s.Ativo ? "" : "text-muted")">
                        <td class="fw-semibold">@s.Tipo</td>
                        <td>
                            @s.Modelo
                            @if (!s.Ativo)
                            {
                                <span class="badge bg-secondary ms-1">Inativo</span>
                            }
                        </td>
                        <td>@s.Faixa</td>
                        <td>@s.LimiteAtencao</td>
                        <td>@s.LimiteCritico</td>
                        <td>
                            @if (s.UltimaLeituraEm != null)
                            {
                                string corLeitura = s.NivelLeitura == "Critico" ? "text-danger"
                                                  : s.NivelLeitura == "Atencao" ? "text-warning-emphasis" : "";

                                <span class="fw-semibold @corLeitura">@s.UltimaLeitura</span>
                                <div class="text-muted small">@s.UltimaLeituraEm</div>
                            }
                            else
                            {
                                <span class="text-muted">Sem leituras</span>
                            }
                        </td>
                        @if (Model.PodeEditar)
                        {
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-modal-url="@Url.Action("FormSensor", "Sensores", new { id = s.Id })">Editar</button>

                                <!-- Desativar mantém o histórico; o sensor inativo só deixa de receber leituras -->
                                <form asp-controller="Sensores" asp-action="AlterarAtivoProcessar" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <input type="hidden" name="ativo" value="@(s.Ativo ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(s.Ativo ? "Desativar" : "Ativar")</button>
                                </form>

                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-excluir-url="@Url.Action("Excluir", "Sensores")" data-excluir-id="@s.Id"
                                        data-excluir-texto="Deseja realmente excluir este sensor? Só é possível excluir sensores que nunca registraram leituras. Para preservar o histórico, use Desativar.">Excluir</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Últimas leituras de cada sensor *@
@if (Model.Sensores.Count > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
        <h2 class="h5 m-0">Histórico de leituras</h2>

        <!-- Filtro de período (RF8, RF13) -->
        <div class="btn-group btn-group-sm" role="group" aria-label="Período">
            @foreach (var per in FichaViewModel.Periodos)
            {
                <a class="btn @(Model.Periodo == per.Codigo ? "btn-primary" : "btn-outline-primary")"
                   asp-action="Index" asp-route-tipo="@Model.Tipo" asp-route-id="@Model.Id" asp-route-periodo="@per.Codigo">@per.Texto</a>
            }
        </div>
    </div>

    <div class="row g-3">
        @foreach (SensorItemViewModel s in Model.Sensores)
        {
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">@s.Tipo <span class="text-muted fw-normal">- @s.Modelo</span></div>

                    @if (s.Leituras.Count == 0)
                    {
                        <div class="card-body text-muted">Nenhuma leitura neste período.</div>
                    }
                    else
                    {
                        <div class="card-body border-bottom py-2 small">
                            <span class="me-3"><span class="text-muted">Leituras:</span> <strong>@s.QuantidadeNoPeriodo</strong></span>
                            <span class="me-3"><span class="text-muted">Mínimo:</span> <strong>@s.Minimo</strong></span>
                            <span class="me-3"><span class="text-muted">Máximo:</span> <strong>@s.Maximo</strong></span>
                            <span><span class="text-muted">Média:</span> <strong>@s.Media</strong></span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr><th>Data e hora</th><th class="text-end">Valor</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (LeituraItemViewModel l in s.Leituras)
                                    {
                                        string cor = l.Nivel == "Critico" ? "text-danger fw-semibold"
                                                   : l.Nivel == "Atencao" ? "text-warning-emphasis fw-semibold" : "";

                                        <tr>
                                            <td>@l.DataHora</td>
                                            <td class="text-end @cor">@l.Valor</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer small text-muted">Mostrando as @s.Leituras.Count leituras mais recentes do período.</div>
                    }
                </div>
            </div>
        }
    </div>
}

@* Alertas mais recentes deste ativo *@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
    <h2 class="h5 m-0">Alertas do ativo</h2>
    <a class="btn btn-sm btn-outline-secondary" asp-controller="Alertas" asp-action="Index">Ver fila de alertas</a>
</div>

@if (Model.Alertas.Count == 0)
{
    <div class="alert alert-light border">Nenhum alerta registrado para este ativo.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nível</th>
                    <th>Sensor</th>
                    <th>Valor lido</th>
                    <th>Data e hora</th>
                    <th>Situação</th>
                    <th>Responsável</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AlertaItemViewModel a in Model.Alertas)
                {
                    string classeNivel = a.Nivel == "Critico" ? "bg-danger" : "bg-warning text-dark";
                    string classeSituacao = a.Status == "Resolvido" ? "bg-success"
                                          : a.Status == "Em analise" ? "bg-info text-dark" : "bg-dark";

                    <tr>
                        <td><span class="badge @classeNivel">@AlertasViewModel.NomeNivel(a.Nivel)</span></td>
                        <td>@a.Sensor</td>
                        <td class="fw-semibold">@a.ValorLido</td>
                        <td class="text-nowrap">@a.DataHora</td>
                        <td><span class="badge @classeSituacao">@AlertasViewModel.NomeSituacao(a.Status)</span></td>
                        <td>@a.Responsavel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
