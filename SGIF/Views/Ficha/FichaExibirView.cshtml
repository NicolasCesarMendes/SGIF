@model FichaViewModel
@{
    ViewData["Title"] = Model.NomeTipo + " " + Model.Numero;

    string classeEstado = Model.Estado switch
    {
        "Ativo" => "badge-success",
        "Em manutencao" => "badge-warning",
        _ => "badge-ghost"
    };
}

<a class="btn btn-sm btn-outline mb-3" asp-controller="Frota" asp-action="FrotaExibir">&larr; Toda a frota</a>

<div class="flex flex-wrap items-center gap-2 mb-3">
    <h1 class="text-2xl m-0">@Model.NomeTipo @Model.Numero</h1>
    <span class="badge @classeEstado">@FrotaViewModel.NomeEstado(Model.Estado)</span>
    <span class="text-muted text-sm" data-vue="atualizacao" data-regiao="regiao-ficha" data-segundos="5">
        <span v-text="status"></span>
        <button type="button" class="btn btn-ghost btn-sm" v-on:click="alternar" v-text="pausado ? 'Retomar' : 'Pausar'">Pausar</button>
    </span>
</div>

<div class="card card-border bg-base-100 mb-4">
    <div class="card-body">
        <dl class="grid grid-cols-12 mb-0">
            @foreach (var (rotulo, valor) in Model.Detalhes)
            {
                <dt class="col-span-6 md:col-span-3">@rotulo</dt>
                <dd class="col-span-6 md:col-span-3">@valor</dd>
            }
        </dl>
    </div>
</div>

<!-- Sensores, leituras e alertas se atualizam sozinhos a cada 5 segundos. -->
<div id="regiao-ficha">

<div class="flex flex-wrap justify-between items-center gap-2 mb-2">
    <h2 class="text-lg m-0">Sensores</h2>

    @if (Model.PodeEditar)
    {
        <button type="button" class="btn btn-primary btn-sm"
                data-modal-url="@Url.Action("FormSensor", "Sensores", new { tipoAtivo = Model.Tipo, idAtivo = Model.Id })">+ Novo sensor</button>
    }
</div>

@if (Model.Sensores.Count == 0)
{
    <div class="alert bg-base-100 border">Nenhum sensor associado a este ativo.</div>
}
else
{
    <div class="overflow-x-auto">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Modelo</th>
                    <th>Faixa de medição</th>
                    <th>Limite de atenção</th>
                    <th>Limite crítico</th>
                    <th>Última leitura</th>
                    @if (Model.PodeEditar)
                    {
                        <th class="text-right">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (SensorItemViewModel s in Model.Sensores)
                {
                    <tr class="@(s.Ativo ?"" : "text-muted")">
                        <td class="font-semibold">@s.Tipo</td>
                        <td>
                            @s.Modelo
                            @if (!s.Ativo)
                            {
                                <span class="badge bg-neutral ms-1">Inativo</span>
                            }
                        </td>
                        <td>@s.Faixa</td>
                        <td>@s.LimiteAtencao</td>
                        <td>@s.LimiteCritico</td>
                        <td>
                            @if (s.UltimaLeituraEm != null)
                            {
                                string corLeitura = s.NivelLeitura == "Critico" ? "text-error"
                                                  : s.NivelLeitura == "Atencao" ? "text-warning" : "";

                                <span class="font-semibold @corLeitura">@s.UltimaLeitura</span>
                                <div class="text-muted text-sm">@s.UltimaLeituraEm</div>
                            }
                            else
                            {
                                <span class="text-muted">Sem leituras</span>
                            }
                        </td>
                        @if (Model.PodeEditar)
                        {
                            <td class="text-right text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline"
                                        data-modal-url="@Url.Action("FormSensor", "Sensores", new { id = s.Id })">Editar</button>

                                <!-- Desativar mantém o histórico; o sensor inativo só deixa de receber leituras -->
                                <form asp-controller="Sensores" asp-action="AlterarAtivoProcessar" method="post" class="inline">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <input type="hidden" name="ativo" value="@(s.Ativo ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm btn-outline">@(s.Ativo ? "Desativar" : "Ativar")</button>
                                </form>

                                <button type="button" class="btn btn-sm btn-outline btn-error"
                                        data-excluir-url="@Url.Action("Excluir", "Sensores")" data-excluir-id="@s.Id"
                                        data-excluir-texto="Deseja realmente excluir este sensor? Só é possível excluir sensores que nunca registraram leituras. Para preservar o histórico, use Desativar.">Excluir</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Últimas leituras de cada sensor *@
@if (Model.Sensores.Count > 0)
{
    <div class="flex flex-wrap justify-between items-center gap-2 mt-4 mb-2">
        <h2 class="text-lg m-0">Histórico de leituras</h2>

        <!-- Filtro de período (RF8, RF13) -->
        <div class="join" role="group" aria-label="Período">
            @foreach (var per in FichaViewModel.Periodos)
            {
                <a class="btn @(Model.Periodo == per.Codigo ?"btn-primary" : "btn-outline")"
                   asp-action="FichaExibir" asp-route-tipo="@Model.Tipo" asp-route-id="@Model.Id" asp-route-periodo="@per.Codigo">@per.Texto</a>
            }
        </div>
    </div>

    <div class="grid grid-cols-12 gap-3">
        @foreach (SensorItemViewModel s in Model.Sensores)
        {
            <div class="col-span-12 lg:col-span-6">
                <div class="card card-border bg-base-100 h-full">
                    <div class="border-b border-base-300 p-4 font-semibold font-semibold">@s.Tipo <span class="text-muted font-normal">- @s.Modelo</span></div>

                    @if (s.Leituras.Count == 0)
                    {
                        <div class="card-body text-muted">Nenhuma leitura neste período.</div>
                    }
                    else
                    {
                        <div class="card-body border-b py-2 text-sm">
                            <span class="me-3"><span class="text-muted">Leituras:</span> <strong>@s.QuantidadeNoPeriodo</strong></span>
                            <span class="me-3"><span class="text-muted">Mínimo:</span> <strong>@s.Minimo</strong></span>
                            <span class="me-3"><span class="text-muted">Máximo:</span> <strong>@s.Maximo</strong></span>
                            <span><span class="text-muted">Média:</span> <strong>@s.Media</strong></span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="table table-xs mb-0">
                                <thead>
                                    <tr><th>Data e hora</th><th class="text-right">Valor</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (LeituraItemViewModel l in s.Leituras)
                                    {
                                        string cor = l.Nivel == "Critico" ? "text-error font-semibold"
                                                   : l.Nivel == "Atencao" ? "text-warning fw-semibold" : "";

                                        <tr>
                                            <td>@l.DataHora</td>
                                            <td class="text-right @cor">@l.Valor</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="border-t border-base-300 p-4 text-sm text-muted text-sm text-muted">Mostrando as @s.Leituras.Count leituras mais recentes do período.</div>
                    }
                </div>
            </div>
        }
    </div>
}

@* Alertas mais recentes deste ativo *@
<div class="flex flex-wrap justify-between items-center gap-2 mt-4 mb-2">
    <h2 class="text-lg m-0">Alertas do ativo</h2>
    <a class="btn btn-sm btn-outline" asp-controller="Alertas" asp-action="AlertasExibir">Ver fila de alertas</a>
</div>

@if (Model.Alertas.Count == 0)
{
    <div class="alert bg-base-100 border">Nenhum alerta registrado para este ativo.</div>
}
else
{
    <div class="overflow-x-auto">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Nível</th>
                    <th>Sensor</th>
                    <th>Valor lido</th>
                    <th>Data e hora</th>
                    <th>Situação</th>
                    <th>Responsável</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AlertaItemViewModel a in Model.Alertas)
                {
                    string classeNivel = a.Nivel == "Critico" ? "badge-error" : "badge-warning";
                    string classeSituacao = a.Status == "Resolvido" ? "badge-success"
                                          : a.Status == "Em analise" ? "badge-info" : "badge-neutral";

                    <tr>
                        <td><span class="badge @classeNivel">@AlertasViewModel.NomeNivel(a.Nivel)</span></td>
                        <td>@a.Sensor</td>
                        <td class="font-semibold">@a.ValorLido</td>
                        <td class="text-nowrap">@a.DataHora</td>
                        <td><span class="badge @classeSituacao">@AlertasViewModel.NomeSituacao(a.Status)</span></td>
                        <td>@a.Responsavel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

</div>
