@model AtivoFormViewModel
@{
    // Mensagens que não pertencem a nenhum campo (ex.: falha ao salvar)
    var errosGerais = ViewData.ModelState[string.Empty]?.Errors;

    bool ehLocomotiva = Model.Tipo == "Locomotiva";
    bool novo = Model.Id == 0;
    string titulo = ehLocomotiva
        ? (novo ? "Nova locomotiva" : "Editar locomotiva")
        : (novo ? "Novo vagão" : "Editar vagão");
}

<form asp-controller="Frota" asp-action="Salvar" method="post" novalidate>
    <div class="flex items-center justify-between border-b border-base-300 p-4">
        <h5 class="text-lg font-semibold">@titulo</h5>
        <button type="button" class="btn btn-ghost btn-sm btn-square" data-modal-close aria-label="Fechar"><partial name="_Icone" model='"x"' /></button>
    </div>

    <div class="space-y-4 p-4">
        @if (errosGerais != null && errosGerais.Count > 0)
        {
            <div class="alert alert-error">@errosGerais[0].ErrorMessage</div>
        }

        <input type="hidden" asp-for="Tipo" />
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="NumeroIdentificacao" class="label font-medium text-sm">Número de identificação</label>
            <input asp-for="NumeroIdentificacao" class="input w-full" maxlength="50" />
            <span asp-validation-for="NumeroIdentificacao" class="text-error text-sm"></span>
        </div>

        @if (ehLocomotiva)
        {
            <div class="mb-3">
                <label asp-for="Modelo" class="label font-medium text-sm">Modelo</label>
                <input asp-for="Modelo" class="input w-full" maxlength="100" />
                <span asp-validation-for="Modelo" class="text-error text-sm"></span>
            </div>

            <div class="grid grid-cols-12">
                <div class="col-span-12 sm:col-span-8 mb-3">
                    <label asp-for="Fabricante" class="label font-medium text-sm">Fabricante</label>
                    <input asp-for="Fabricante" class="input w-full" maxlength="100" />
                    <span asp-validation-for="Fabricante" class="text-error text-sm"></span>
                </div>
                <div class="col-span-12 sm:col-span-4 mb-3">
                    <label asp-for="AnoFabricacao" class="label font-medium text-sm">Ano</label>
                    <input asp-for="AnoFabricacao" type="number" min="1800" max="2100" class="input w-full" />
                    <span asp-validation-for="AnoFabricacao" class="text-error text-sm"></span>
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label asp-for="TipoVagao" class="label font-medium text-sm">Tipo do vagão</label>
                <input asp-for="TipoVagao" class="input w-full" maxlength="100" />
                <span asp-validation-for="TipoVagao" class="text-error text-sm"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacidade" class="label font-medium text-sm">Capacidade</label>
                <input asp-for="Capacidade" class="input w-full" inputmode="decimal" placeholder="Exemplo: 50,5" />
                <span asp-validation-for="Capacidade" class="text-error text-sm"></span>
            </div>
        }

        <div class="mb-1">
            <label asp-for="Estado" class="label font-medium text-sm">Estado</label>
            <select asp-for="Estado" class="select w-full">
                @foreach (var estado in FrotaViewModel.Estados)
                {
                    <option value="@estado">@FrotaViewModel.NomeEstado(estado)</option>
                }
            </select>
            <span asp-validation-for="Estado" class="text-error text-sm"></span>
        </div>
    </div>

    <div class="flex justify-end gap-2 border-t border-base-300 p-4">
        <button type="button" class="btn btn-outline" data-modal-close>Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
    </div>
</form>
